# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://fqsqfxshjedljagxytat.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Who may sign in (comma-separated). They still need a team_members row to see data.
ALLOWED_EMAIL_DOMAINS=paradigmshifters.in
ALLOWED_EMAILS=

# "on" once Google is enabled in Supabase (Authentication → Providers → Google)
NEXT_PUBLIC_GOOGLE_SIGNIN=

# The product's name on screen (sidebar, sign-in, tab titles, share notes). Blank = Paradigm Shifters.
# BRAND_SHORT is the badge letters (default: initials); BRAND_PLACE the line under the sign-in art ("-" hides it).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT=
NEXT_PUBLIC_BRAND_PLACE=

# The CV reader (Candidates → CV inbox). The firm's own Claude API key from console.anthropic.com; server only.
# Also needs an admin to switch it on in Settings. ANTHROPIC_MODEL is optional (default claude-haiku-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Local testing only: "1" pretends to read CVs without calling Claude.
CV_READER_FAKE=

# Connect Google (Settings → Google account): the firm's own Google Cloud project, see docs/google-setup.md.
# GOOGLE_TOKEN_KEY encrypts the stored tokens: any long random text, server only, never change it.
# GOOGLE_REDIRECT_URI is optional (default: <site>/api/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
GOOGLE_REDIRECT_URI=
